# =============================================================================
# QRRA — переменные окружения
# Скопируй в локальный `.env.local` и в Vercel → Settings → Environment Variables
# (Production + Preview; для Preview можно те же значения или тестовые)
# =============================================================================

# --- Supabase (обязательно) ---
# Dashboard → Settings → API → Project URL (без /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Dashboard → Settings → API → anon public key (eyJ…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# НЕ подставлять сюда:
# - Postgres connection string (postgresql://…)
# - URL с путём /rest/v1

# --- Сайт и контакты (витрина) ---
# Публичный URL сайта — для Open Graph и ссылок в письмах
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# WhatsApp: только цифры, код страны (Узбекистан 998…)
NEXT_PUBLIC_WHATSAPP_NUMBER=998901234567

# Telegram username без @
NEXT_PUBLIC_TELEGRAM_USERNAME=qrra

NEXT_PUBLIC_CONTACT_EMAIL=hello@qrra.store

# --- Уведомления (опционально; без них заказы работают) ---
# Telegram: @BotFather → token; chat id — через getUpdates или @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email статуса заказа: https://resend.com → API Keys
RESEND_API_KEY=
# Домен должен быть верифицирован в Resend
RESEND_FROM=QRRA <hello@your-domain.com>
